# Optional: lets the "Explain simply" button rephrase scheme text with an LLM.
# Without a key the app uses the curated plain-language text stored in the database.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: where the SQLite file lives (default: data/yojanasaathi.db)
YS_DB_PATH=
